[Unit]
Description=CNS maintenance enrollment awaiting operator approval
Wants=network-online.target
After=network-online.target
ConditionPathExists=!/etc/cns-rpi-maintenance.json

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/cns-rpi/maintenance-current/enrollment_client.py --config /etc/cns-rpi-enrollment.json
